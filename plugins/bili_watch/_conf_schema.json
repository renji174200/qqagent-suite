{
  "enable": {
    "description": "启用B站视频观看",
    "type": "bool",
    "default": true
  },
  "provider_id": {
    "description": "视觉模型 provider ID",
    "type": "string",
    "default": "deepseek"
  },
  "sessdata": {
    "description": "B站 SESSDATA",
    "type": "string",
    "default": "",
    "hint": "用于拉取需要登录的视频信息"
  },
  "frames": {
    "description": "抽帧数量",
    "type": "int",
    "default": 12,
    "hint": "越多看得越细，token 也越多"
  },
  "frame_width": {
    "description": "单帧宽度（px）",
    "type": "int",
    "default": 960
  },
  "max_duration_sec": {
    "description": "视频最长时长（秒）",
    "type": "int",
    "default": 900
  },
  "max_download_mb": {
    "description": "最大下载体积（MB）",
    "type": "int",
    "default": 45
  },
  "require_at_in_group": {
    "description": "群里必须 @ 才看",
    "type": "bool",
    "default": true
  },
  "cooldown_sec": {
    "description": "同视频冷却（秒）",
    "type": "int",
    "default": 60
  },
  "note_ttl_minutes": {
    "description": "视频笔记有效期（分钟）",
    "type": "int",
    "default": 120
  }
}